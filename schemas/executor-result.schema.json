{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"project-resolver/executor-result.schema.json",
  "title":"EXECUTOR_RESULT",
  "type":"object",
  "required":["artifact_type","artifact_id","produced_by_role","assignment_id","input_state_ref","status","provenance","related_artifacts","resulting_state_refs","evidence_refs","deferred_findings","limitations","claims"],
  "properties":{
    "artifact_type":{"const":"EXECUTOR_RESULT"},
    "artifact_id":{"type":"string","minLength":1},
    "produced_by_role":{"const":"executor"},
    "assignment_id":{"type":"string","minLength":1},
    "input_state_ref":{"type":["string","null"]},
    "status":{"enum":["COMPLETE","PARTIAL","BLOCKED","FAILED"]},
    "provenance":{"type":"array","items":{"type":"string"}},
    "related_artifacts":{"type":"array","items":{"type":"string"}},
    "resulting_state_refs":{"type":"array","items":{"type":"string"}},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "deferred_findings":{"type":"array","items":{"type":"string"}},
    "limitations":{"type":"array","items":{"type":"string"}},
    "durable_output_refs":{
      "type":"array",
      "uniqueItems":true,
      "items":{
        "type":"object",
        "required":["output_id","artifact_ref"],
        "properties":{
          "output_id":{"type":"string","minLength":1,"pattern":".*\\S.*"},
          "artifact_ref":{"type":"string","minLength":1,"pattern":".*\\S.*"}
        },
        "additionalProperties":false
      }
    },
    "published_candidate":{
      "type":"object",
      "required":["kind","repository","ref","head_sha"],
      "properties":{
        "kind":{"enum":["PULL_REQUEST","BRANCH"]},
        "repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "ref":{"oneOf":[{"type":"integer","minimum":1},{"type":"string","minLength":1}]},
        "head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}
      },
      "additionalProperties":false
    },
    "claims":{"type":"array","items":{"type":"object","required":["claim_id","claim","evidence_refs"],"properties":{"claim_id":{"type":"string","minLength":1},"claim":{"type":"string"},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}},"additionalProperties":true}}
  },
  "additionalProperties":true
}
